# Optional Snowflake PAT path (hosted backend toggle + scripts/cortex.py) — never commit real values
# SNOWFLAKE_ACCOUNT=ORG-ACCOUNT          # or SNOWFLAKE_HOST=ORG-ACCOUNT.snowflakecomputing.com for cortex.py
# SNOWFLAKE_USER=VC_FLY_SVC              # service user holding only AQ_VC_READER
# SNOWFLAKE_PAT=                         # role-restricted programmatic access token
# SNOWFLAKE_ROLE=AQ_VC_READER            # optional
# SNOWFLAKE_WAREHOUSE=AQ_VC_RETAIL_WH    # optional

# Cloudflare (Tunnel + Access + DNS for permanent share). Never commit real values.
# Same account/zone as FORTH relief.datasharkbi.com
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_WITH_API_TOKEN
CLOUDFLARE_DEMO_HOSTNAME=vc.datasharkbi.com
CLOUDFLARE_ACCESS_ALLOW_EMAIL=you@example.com
